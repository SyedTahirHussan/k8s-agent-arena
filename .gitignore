# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets - never commit API keys
.env
.env.*
!.env.example
*.key

# Kubeconfigs pulled from throwaway clusters
kubeconfig
*.kubeconfig

# Run artifacts. Ad-hoc sweeps stay local; the curated reference runs under
# results/reference/ are committed, because a benchmark should ship the evidence
# behind the numbers in its README.
# Ignore the contents, not the directory itself - git does not descend into an
# ignored directory, so `results/` would make the negation below unreachable.
results/*
!results/reference/
.pytest_cache/

# macOS
.DS_Store
