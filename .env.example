# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
#   cp .env.example .env
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model under test. Flash has a free tier; the Pro preview is paid-tier only.
# NOTE: gemini-3.1-pro-preview is documented as prone to ignoring custom tool
# definitions in favour of bash. Use gemini-3.1-pro-preview-customtools if you
# switch to Pro, and record which variant produced your results.
ARENA_MODEL=gemini-3.6-flash
